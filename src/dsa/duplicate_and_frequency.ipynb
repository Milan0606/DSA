   "source": [
    "# Remove duplicates while preserving order\n",
    "numbers = [1, 2, 2, 3, 1, 4, 5, 6, 7, 7, 7] \n",
    "\n",
    "for i in range(len(numbers)):\n",
    "    for j in range(i+1, len(numbers)):\n",
    "        if numbers[i] == numbers[j]:\n",
    "            print(\"duplicate number is\",  numbers[i])"
   ]
